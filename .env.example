# SCHEMORA AI - Environment Variables Template
# Copy this file to .env or .env.local and populate the values.
# DO NOT commit real secrets to version control.

# -----------------------------------------------------------------------------
# AI Assistant (Backend)
# -----------------------------------------------------------------------------

# Grok (xAI) API Key used by the /api/assistant route
# Required for the assistant to provide multilingual support.
GROK_API_KEY=

# The specific LLM model the assistant should use (e.g., grok-beta)
GROK_MODEL=grok-beta

# The base URL for the Grok API (OpenAI-compatible)
GROK_API_BASE_URL=https://api.x.ai/v1

# OpenAI configuration removed/commented out to avoid confusion
# OPENAI_API_KEY=sk-proj-placeholder-key
# OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Rate Limiting & Security
# -----------------------------------------------------------------------------

# Maximum number of assistant requests a single IP can make per minute
RATE_LIMIT_MAX_REQUESTS=10

# Maximum character length for a single user message to the assistant
MAX_MESSAGE_LENGTH=500
