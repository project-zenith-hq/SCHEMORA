# SCHEMORA AI - Environment Variables Template
# Copy this file to .env or .env.local and populate the values.
# DO NOT commit real secrets to version control.

# -----------------------------------------------------------------------------
# AI Assistant (Backend)
# -----------------------------------------------------------------------------

# OpenAI API Key used by the /api/assistant route
# Required if the assistant is utilizing OpenAI for inference.
OPENAI_API_KEY=sk-proj-placeholder-key

# The specific LLM model the assistant should use (e.g., gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Rate Limiting & Security
# -----------------------------------------------------------------------------

# Maximum number of assistant requests a single IP can make per minute
RATE_LIMIT_MAX_REQUESTS=10

# Maximum character length for a single user message to the assistant
MAX_MESSAGE_LENGTH=500
